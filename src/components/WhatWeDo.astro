---
const offerings = [
  {
    title: "Business Acquisition",
    description:
      "We acquire established businesses across North America, providing owners with a credible, well-capitalized buyer and a smooth path to transition.",
    icon: '<path d="M3 21h18" /><path d="M5 21V7l8-4v18" /><path d="M19 21V11l-6-4" /><path d="M9 9v.01" /><path d="M9 12v.01" /><path d="M9 15v.01" /><path d="M9 18v.01" />',
  },
  {
    title: "Exit Strategy",
    description:
      "We work alongside owners to structure a clear, confident exit, handling the complexity so you can step away on your own terms.",
    icon: '<path d="M9 11l3 3 8-8" /><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" />',
  },
  {
    title: "Legacy Protection",
    description:
      "We protect the legacy you have sacrificed to build, preserving your people, reputation, and everything your business stands for.",
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />',
  },
];
---

<section id="what-we-do" class="py-20 lg:py-28 relative overflow-hidden bg-dark">
  <!-- Decorative network (left) -->
  <svg class="absolute left-0 bottom-0 w-72 h-full opacity-[0.07] max-lg:hidden" viewBox="0 0 300 600" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M-10 40 H120 Q160 40 160 80 V200 Q160 240 200 240 H320" stroke="white" stroke-width="2" />
    <path d="M-10 320 H80 Q120 320 120 360 V480 Q120 520 160 520 H320" stroke="white" stroke-width="1.5" opacity="0.6" />
    <circle cx="160" cy="80" r="5" fill="#c9a227" />
    <circle cx="120" cy="360" r="5" fill="white" />
  </svg>
  <!-- Decorative network (right, mirrored for balance) -->
  <svg class="absolute right-0 bottom-0 w-72 h-full opacity-[0.07] -scale-x-100 max-lg:hidden" viewBox="0 0 300 600" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M-10 40 H120 Q160 40 160 80 V200 Q160 240 200 240 H320" stroke="white" stroke-width="2" />
    <path d="M-10 320 H80 Q120 320 120 360 V480 Q120 520 160 520 H320" stroke="white" stroke-width="1.5" opacity="0.6" />
    <circle cx="160" cy="80" r="5" fill="#c9a227" />
    <circle cx="120" cy="360" r="5" fill="white" />
  </svg>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-14 animate-on-scroll">
      <p class="text-accent font-semibold text-sm uppercase tracking-[0.2em] mb-3">What We Do</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
        An investment consortium dedicated to acquiring businesses
      </h2>
      <p class="text-white/70 text-lg leading-relaxed">
        The Omega Group is an investment consortium dedicated to acquiring
        businesses in North America. We assist owners with an exit strategy
        while protecting the legacy they have sacrificed to build.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 stagger-children">
      {offerings.map((o) => (
        <div class="animate-on-scroll group bg-white/5 border border-white/10 rounded-2xl p-8 hover:bg-white/[0.08] hover:border-accent/40 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-accent/15 text-accent flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={o.icon} />
          </div>
          <h3 class="text-xl font-bold text-white mb-3">{o.title}</h3>
          <p class="text-white/65 leading-relaxed">{o.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
