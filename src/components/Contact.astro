---
const contactInfo = [
  {
    label: "Phone",
    value: "615-998-4788",
    href: "tel:+16159984788",
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />',
  },
  {
    label: "Email",
    value: "admin@tomegag.com",
    href: "mailto:admin@tomegag.com",
    icon: '<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
  },
  {
    label: "Coverage",
    value: "North America",
    href: null,
    icon: '<circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />',
  },
];
---

<section id="contact" class="py-20 lg:py-28 relative overflow-hidden bg-grid-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-14 animate-on-scroll">
      <p class="text-primary font-semibold text-sm uppercase tracking-[0.2em] mb-3">Contact Us</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-dark mb-4">Let's start the conversation</h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">
        Considering an exit, or simply want to explore your options? Reach out. Every conversation is confidential.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-10 lg:gap-14">
      <!-- Info -->
      <div class="lg:col-span-2 space-y-5 animate-on-scroll from-left">
        {contactInfo.map((item) => {
          const Tag = item.href ? "a" : "div";
          return (
            <Tag
              {...(item.href ? { href: item.href } : {})}
              class="flex items-center gap-4 p-5 bg-white rounded-xl border border-border/60 hover:shadow-md transition-shadow"
            >
              <div class="shrink-0 w-11 h-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </div>
              <div class="flex-1">
                <p class="text-muted text-sm">{item.label}</p>
                <p class="font-semibold text-dark">{item.value}</p>
              </div>
            </Tag>
          );
        })}

        <div class="p-6 rounded-xl bg-primary text-white">
          <p class="font-semibold text-lg mb-1">Protecting your legacy</p>
          <p class="text-white/75 text-sm leading-relaxed">
            We assist owners with a seamless exit strategy while safeguarding everything they have built.
          </p>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3 animate-on-scroll from-right">
        <div class="bg-white rounded-2xl shadow-lg border border-border/50 p-8">
          <form id="contact-form" novalidate aria-label="Contact form" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="cf-name" class="block text-sm font-medium text-dark mb-1.5">Name</label>
                <input type="text" id="cf-name" name="name" required autocomplete="name"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-light text-dark focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                  placeholder="Your name" />
              </div>
              <div>
                <label for="cf-phone" class="block text-sm font-medium text-dark mb-1.5">Phone Number</label>
                <input type="tel" id="cf-phone" name="phone" autocomplete="tel"
                  class="w-full px-4 py-3 rounded-lg border border-border bg-light text-dark focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                  placeholder="(000) 000-0000" />
              </div>
            </div>
            <div>
              <label for="cf-email" class="block text-sm font-medium text-dark mb-1.5">Email</label>
              <input type="email" id="cf-email" name="email" required autocomplete="email"
                class="w-full px-4 py-3 rounded-lg border border-border bg-light text-dark focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"
                placeholder="you@company.com" />
            </div>
            <div>
              <label for="cf-message" class="block text-sm font-medium text-dark mb-1.5">Message</label>
              <textarea id="cf-message" name="message" rows="5" required
                class="w-full px-4 py-3 rounded-lg border border-border bg-light text-dark focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none"
                placeholder="Tell us a little about your business..."></textarea>
            </div>

            <!-- Honeypot: hidden from humans, traps bots -->
            <div class="hidden" aria-hidden="true">
              <label for="cf-website">Website</label>
              <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" id="cf-submit"
              class="w-full bg-primary text-white px-7 py-3.5 rounded-lg font-semibold text-lg hover:bg-primary-dark transition-colors shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
              Send Message
            </button>
            <p id="cf-status" class="text-center font-medium min-h-[1.2em]" role="status"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("cf-status");
  const button = document.getElementById("cf-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !button) return;
    status.textContent = "";
    status.style.color = "";
    button.disabled = true;
    button.textContent = "Sending…";

    try {
      const res = await fetch("/send.php", {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const data = await res.json();
      if (data.ok) {
        status.textContent = data.message;
        status.style.color = "#16a34a";
        form.reset();
      } else {
        status.textContent = data.message || "Something went wrong.";
        status.style.color = "#dc2626";
      }
    } catch {
      status.textContent = "Network error. Please try again.";
      status.style.color = "#dc2626";
    } finally {
      button.disabled = false;
      button.textContent = "Send Message";
    }
  });
</script>
