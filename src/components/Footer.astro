---
const year = new Date().getFullYear();
const navLinks = [
  { label: "About Us", href: "#about" },
  { label: "What We Do", href: "#what-we-do" },
  { label: "Contact", href: "#contact" },
];
---

<footer class="bg-dark text-white/70">
  <div class="max-w-7xl mx-auto px-6 py-14 lg:py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-2">
        <div class="inline-block bg-white rounded-lg px-4 py-3 mb-5">
          <img src="/images/tog-logo.png" alt="The Omega Group" class="h-10 w-auto" />
        </div>
        <p class="text-sm leading-relaxed max-w-md">
          The Omega Group is an investment consortium dedicated to acquiring
          businesses in North America, assisting owners with an exit strategy
          while protecting the legacy they have sacrificed to build.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Explore</h3>
        <ul class="space-y-2.5">
          {navLinks.map((link) => (
            <li><a href={link.href} class="text-sm hover:text-white transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Contact</h3>
        <ul class="space-y-3">
          <li>
            <a href="tel:+16159984788" class="flex items-center gap-2 text-sm hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
              615-998-4788
            </a>
          </li>
          <li>
            <a href="mailto:admin@tomegag.com" class="flex items-center gap-2 text-sm hover:text-white transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
              admin@tomegag.com
            </a>
          </li>
          <li class="flex items-center gap-2 text-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
            North America
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/40">© {year} The Omega Group. All rights reserved.</p>
      <p class="text-xs text-white/40">Acquiring businesses · Protecting legacies</p>
    </div>
  </div>
</footer>
