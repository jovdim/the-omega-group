---
---

<section id="top" class="relative min-h-[92vh] flex items-center overflow-hidden">
  <!-- Background skyline -->
  <div class="absolute inset-0">
    <img src="/images/about-image.jpg" alt="Financial district skyline" class="w-full h-full object-cover hero-bg-zoom" />
    <!-- Navy gradient overlay for depth + readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-dark/90 via-dark/80 to-dark/60"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 w-full">
    <div class="max-w-3xl">
      <p class="hero-fade-1 text-accent font-semibold text-sm uppercase tracking-[0.2em] mb-5">
        The Omega Group
      </p>
      <h1 class="hero-fade-1 text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-white leading-[1.08] mb-7">
        Acquiring businesses.<br />
        <span class="text-accent">Protecting legacies.</span>
      </h1>
      <p class="hero-fade-2 text-lg sm:text-xl text-white/75 max-w-2xl mb-10 leading-relaxed">
        An investment consortium dedicated to acquiring businesses across North
        America, helping owners exit with confidence while safeguarding
        everything they have sacrificed to build.
      </p>
      <div class="hero-fade-3 flex flex-wrap gap-4">
        <a href="#contact" class="group inline-flex items-center gap-2 sm:gap-3 bg-accent text-dark px-5 py-2.5 text-base sm:px-8 sm:py-4 sm:text-lg rounded-xl font-semibold hover:bg-accent-dark transition-all duration-300">
          Start the Conversation
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sm:w-[18px] sm:h-[18px] group-hover:translate-x-1 transition-transform duration-300"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
        <a href="#what-we-do" class="inline-flex items-center gap-2 border-2 border-white/25 text-white px-5 py-2.5 text-base sm:px-8 sm:py-4 sm:text-lg rounded-xl font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">
          What We Do
        </a>
      </div>
    </div>
  </div>
</section>
