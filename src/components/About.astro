---
const expertise = [
  {
    title: "M&A Transactions",
    icon: '<circle cx="18" cy="18" r="3" /><circle cx="6" cy="6" r="3" /><path d="M6 21V9a9 9 0 0 0 9 9" />',
  },
  {
    title: "Investments",
    icon: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17" /><polyline points="16 7 22 7 22 13" />',
  },
  {
    title: "Entrepreneurship",
    icon: '<path d="M9 18h6" /><path d="M10 22h4" /><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />',
  },
  {
    title: "Leadership",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />',
  },
];
---

<section id="about" class="py-20 lg:py-28 relative overflow-hidden bg-grid-light">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Text -->
      <div class="animate-on-scroll from-left">
        <p class="text-primary font-semibold text-sm uppercase tracking-[0.2em] mb-3">About Us</p>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-dark mb-6 leading-[1.15]">
          A formidable team, built on decades of experience
        </h2>

        <p class="text-muted text-lg leading-relaxed mb-8">
          With diversified backgrounds in M&amp;A transactions, Investments,
          Entrepreneurship and Leadership, we have formed a formidable team with a track record of
          closing over <span class="text-dark font-semibold">1,000 transactions</span>
          with an aggregate value of <span class="text-dark font-semibold">billions
          of dollars</span>.
        </p>

        <!-- Expertise grid -->
        <div class="grid sm:grid-cols-2 gap-3 mb-9">
          {expertise.map((e) => (
            <div class="flex items-center gap-3 p-4 bg-white rounded-xl border border-border/60 hover:border-primary/30 hover:shadow-sm transition-all">
              <div class="shrink-0 w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={e.icon} />
              </div>
              <span class="font-semibold text-dark text-sm leading-tight">{e.title}</span>
            </div>
          ))}
        </div>

        <a href="#contact" class="inline-flex items-center gap-2 text-primary font-semibold hover:gap-3 transition-all">
          Get in touch
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>

      <!-- Image + floating stat badges -->
      <div class="animate-on-scroll from-right relative lg:pr-6">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img src="/images/about-image.jpg" alt="The Omega Group financial district" class="w-full h-auto object-cover" loading="lazy" />
          <div class="absolute inset-0 ring-1 ring-inset ring-dark/10 rounded-2xl"></div>
        </div>

        <!-- Primary badge: years of experience -->
        <div class="absolute -bottom-6 left-4 sm:-left-6 bg-white rounded-2xl shadow-xl border border-border/50 px-7 py-5">
          <p class="text-4xl font-bold text-primary leading-none">200<span class="text-accent">+</span></p>
          <p class="text-muted text-sm mt-1.5 leading-tight">Years of combined<br />experience</p>
        </div>

        <!-- Secondary chip: transactions -->
        <div class="absolute -top-5 -right-2 sm:-right-5 bg-primary text-white rounded-xl shadow-lg px-5 py-3">
          <p class="text-xl font-bold leading-none">Billions</p>
          <p class="text-white/70 text-xs mt-1">in transactions</p>
        </div>
      </div>
    </div>
  </div>
</section>
