---
const navLinks = [
  { label: "About Us", href: "#about" },
  { label: "What We Do", href: "#what-we-do" },
  { label: "Contact", href: "#contact" },
];
---

<!-- Main navbar -->
<nav id="navbar" class="sticky top-0 z-50 bg-white transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-20">
    <a href="#top" class="shrink-0">
      <img src="/images/tog-logo.png" alt="The Omega Group" class="h-11 w-auto" />
    </a>

    <!-- Desktop links -->
    <div class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium px-4 py-2 rounded-lg text-secondary hover:text-primary transition-colors">
          {link.label}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <a href="#contact" class="hidden lg:inline-flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded-lg font-semibold text-sm hover:bg-primary-dark transition-colors">
      Get in Touch
    </a>

    <!-- Mobile hamburger -->
    <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
      <span class="bar block w-6 h-0.5 bg-secondary transition-all duration-300"></span>
      <span class="bar block w-6 h-0.5 bg-secondary transition-all duration-300"></span>
      <span class="bar block w-6 h-0.5 bg-secondary transition-all duration-300"></span>
    </button>
  </div>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-40 lg:hidden invisible transition-all duration-300">
  <div id="mobile-overlay" class="absolute inset-0 bg-dark/50 opacity-0 transition-opacity duration-300"></div>
  <div id="mobile-panel" class="absolute right-0 top-0 h-full w-80 max-w-[85vw] bg-white shadow-2xl translate-x-full transition-transform duration-300 overflow-y-auto">
    <div class="p-6 pt-24 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-link flex items-center px-4 py-3 rounded-lg text-secondary hover:bg-primary/5 hover:text-primary transition-colors font-medium">
          {link.label}
        </a>
      ))}
      <a href="tel:+16159984788" class="mt-4 flex items-center justify-center gap-2 bg-primary text-white px-5 py-3 rounded-lg font-semibold text-lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
        615-998-4788
      </a>
    </div>
  </div>
</div>

<script>
  // Shadow / blur on scroll
  const navbar = document.getElementById("navbar");
  const onScroll = () => {
    if (window.scrollY > 40) {
      navbar?.classList.add("shadow-md");
    } else {
      navbar?.classList.remove("shadow-md");
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("mobile-overlay");
  const panel = document.getElementById("mobile-panel");
  const bars = toggle?.querySelectorAll(".bar");

  const open = () => {
    menu?.classList.remove("invisible");
    overlay?.classList.add("opacity-100");
    panel?.classList.remove("translate-x-full");
    document.body.style.overflow = "hidden";
    bars?.[0]?.classList.add("rotate-45", "translate-y-2");
    bars?.[1]?.classList.add("opacity-0");
    bars?.[2]?.classList.add("-rotate-45", "-translate-y-2");
  };
  const close = () => {
    overlay?.classList.remove("opacity-100");
    panel?.classList.add("translate-x-full");
    document.body.style.overflow = "";
    bars?.[0]?.classList.remove("rotate-45", "translate-y-2");
    bars?.[1]?.classList.remove("opacity-0");
    bars?.[2]?.classList.remove("-rotate-45", "-translate-y-2");
    setTimeout(() => menu?.classList.add("invisible"), 300);
  };

  let isOpen = false;
  toggle?.addEventListener("click", () => { isOpen = !isOpen; isOpen ? open() : close(); });
  overlay?.addEventListener("click", () => { isOpen = false; close(); });
  document.querySelectorAll(".mobile-link").forEach((l) =>
    l.addEventListener("click", () => { isOpen = false; close(); })
  );
</script>
